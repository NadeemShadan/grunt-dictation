# Path to bundled or custom whisper-cli binary.
WHISPER_CLI=/usr/lib/grunt-dictation/whisper-cli

# How whisper-cli should be resolved during install/bootstrap.
# Values: auto | bundled | download
WHISPER_CLI_SOURCE=auto

# Optional download URL template used when bundled binary is missing.
# Tokens: {version}, {arch}
# Example: https://downloads.example.com/whisper/{version}/linux-{arch}/whisper-cli
WHISPER_CLI_URL_TEMPLATE=
WHISPER_CLI_VERSION=v1.0.0

# Download a model and set this path, for example:
# ~/.local/share/grunt-dictation/models/ggml-base.en.bin
MODEL_PATH=$HOME/.local/share/grunt-dictation/models/ggml-base.en.bin

# URL used by `grunt-dictationctl download-model`.
# Override to use a different model or mirror.
WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin

# Optional SHA256 checksum for the model file, verified after download.
# Leave empty to skip verification.
WHISPER_MODEL_SHA256=

# PulseAudio/PipeWire/ALSA source name. "default" works for most setups.
# Run `grunt-dictationctl list-devices` to see available devices.
AUDIO_DEVICE=default

# Audio backend. Values: auto | pulse | pipewire | alsa
# auto detects the running audio system at record time.
AUDIO_FORMAT=auto

# Maximum recording duration in seconds before auto-stop (default: 5 minutes).
MAX_RECORD_SECONDS=300

# Limit local transcription work so the desktop remains responsive.
WHISPER_THREADS=2
WHISPER_NICE_LEVEL=10
WHISPER_LANGUAGE=en

# Paste a completed transcript into the application that is focused when
# transcription finishes. The paste uses the clipboard instead of typing each
# character, avoiding lost characters and stuck modifier keys.
AUTO_PASTE=true
PASTE_DELAY_SECONDS=0.35
