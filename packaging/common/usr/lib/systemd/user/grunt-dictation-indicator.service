[Unit]
Description=Grunt Dictation Tray Indicator
After=graphical-session.target grunt-dictationd.service
Wants=grunt-dictationd.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/lib/grunt-dictation/grunt-dictation-indicator
Restart=on-failure
RestartSec=5
TimeoutStopSec=3

[Install]
WantedBy=graphical-session.target
